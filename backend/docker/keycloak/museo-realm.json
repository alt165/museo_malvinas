{
  "realm": "museo",
  "enabled": true,
  "loginTheme": "museo-login",
  "userProfileMetadata": {
    "attributes": [
      {
        "name": "username",
        "displayName": "${username}",
        "validations": {
          "length": {
            "min": 3,
            "max": 255
          },
          "username-prohibited-characters": {},
          "up-username-not-idn-homograph": {}
        },
        "permissions": {
          "view": [
            "admin",
            "user"
          ],
          "edit": [
            "admin",
            "user"
          ]
        },
        "multivalued": false
      },
      {
        "name": "email",
        "displayName": "${email}",
        "validations": {
          "email": {},
          "length": {
            "max": 255
          }
        },
        "required": {
          "roles": [
            "user"
          ]
        },
        "permissions": {
          "view": [
            "admin",
            "user"
          ],
          "edit": [
            "admin",
            "user"
          ]
        },
        "multivalued": false
      },
      {
        "name": "firstName",
        "displayName": "${firstName}",
        "validations": {
          "length": {
            "max": 255
          },
          "person-name-prohibited-characters": {}
        },
        "required": {
          "roles": [
            "user"
          ]
        },
        "permissions": {
          "view": [
            "admin",
            "user"
          ],
          "edit": [
            "admin",
            "user"
          ]
        },
        "multivalued": false
      },
      {
        "name": "lastName",
        "displayName": "${lastName}",
        "validations": {
          "length": {
            "max": 255
          },
          "person-name-prohibited-characters": {}
        },
        "required": {
          "roles": [
            "user"
          ]
        },
        "permissions": {
          "view": [
            "admin",
            "user"
          ],
          "edit": [
            "admin",
            "user"
          ]
        },
        "multivalued": false
      },
      {
        "name": "dni",
        "displayName": "DNI",
        "validations": {
          "length": {
            "min": 7,
            "max": 20
          },
          "pattern": {
            "pattern": "^[0-9]+$",
            "error-message": "El DNI solo puede contener digitos"
          }
        },
        "required": {
          "roles": [
            "user"
          ]
        },
        "permissions": {
          "view": [
            "admin",
            "user"
          ],
          "edit": [
            "admin",
            "user"
          ]
        },
        "multivalued": false,
        "annotations": {
          "inputType": "text"
        }
      }
    ],
    "groups": [
      {
        "name": "user-metadata",
        "displayHeader": "User metadata",
        "displayDescription": "Attributes, which refer to user metadata"
      }
    ]
  },
  "roles": {
    "realm": [
      {
        "name": "ADMIN"
      },
      {
        "name": "OPERATOR"
      },
      {
        "name": "VIEWER"
      }
    ]
  },
  "clients": [
    {
      "clientId": "museo-backend",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "museo-local",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:13000/*",
        "http://localhost:8080/*",
        "http://localhost:18080/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:13000",
        "http://localhost:8080",
        "http://localhost:18080"
      ],
      "protocol": "openid-connect"
    },
    {
      "clientId": "museo-frontend",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:13000/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:13000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocol": "openid-connect"
    },
    {
      "clientId": "museo-admin",
      "enabled": true,
      "publicClient": false,
      "secret": "museo-admin-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN"
      ],
      "firstName": "Admin",
      "lastName": "Local",
      "requiredActions": [],
      "email": "admin@local.test",
      "attributes": {
        "dni": [
          "10000001"
        ]
      }
    },
    {
      "username": "operator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "operator",
          "temporary": false
        }
      ],
      "realmRoles": [
        "OPERATOR"
      ],
      "firstName": "Operator",
      "lastName": "Local",
      "requiredActions": [],
      "email": "operator@local.test",
      "attributes": {
        "dni": [
          "10000002"
        ]
      }
    },
    {
      "username": "viewer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "viewer",
          "temporary": false
        }
      ],
      "realmRoles": [
        "VIEWER"
      ],
      "firstName": "Viewer",
      "lastName": "Local",
      "requiredActions": [],
      "email": "viewer@local.test",
      "attributes": {
        "dni": [
          "10000003"
        ]
      }
    },
    {
      "username": "service-account-museo-admin",
      "enabled": true,
      "serviceAccountClientId": "museo-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-realm",
          "view-users",
          "query-users"
        ]
      }
    }
  ]
}
