{
  "realm": "museo",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "ADMIN"
      },
      {
        "name": "OPERATOR"
      },
      {
        "name": "VIEWER"
      }
    ]
  },
  "clients": [
    {
      "clientId": "museo-backend",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "museo-local",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:8080"
      ],
      "protocol": "openid-connect"
    },
    {
      "clientId": "museo-frontend",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocol": "openid-connect"
    },
    {
      "clientId": "museo-admin",
      "enabled": true,
      "publicClient": false,
      "secret": "museo-admin-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN"
      ],
      "firstName": "Admin",
      "lastName": "Local",
      "requiredActions": [],
      "email": "admin@local.test"
    },
    {
      "username": "operator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "operator",
          "temporary": false
        }
      ],
      "realmRoles": [
        "OPERATOR"
      ],
      "firstName": "Operator",
      "lastName": "Local",
      "requiredActions": [],
      "email": "operator@local.test"
    },
    {
      "username": "viewer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "viewer",
          "temporary": false
        }
      ],
      "realmRoles": [
        "VIEWER"
      ],
      "firstName": "Viewer",
      "lastName": "Local",
      "requiredActions": [],
      "email": "viewer@local.test"
    },
    {
      "username": "service-account-museo-admin",
      "enabled": true,
      "serviceAccountClientId": "museo-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      }
    }
  ]
