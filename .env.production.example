# Copy this file outside the repository as .env.production, chmod 600 it,
# replace every CHANGE_ME value, and invoke Compose with --env-file.
COMPOSE_PROJECT_NAME=museo-prod
MUSEO_DATA_DIR=/srv/museo/data
TLS_CERT_DIR=/srv/museo/tls
BACKUP_DESTINATION=/mnt/museo-backups

APP_HOST=museo.example.org
AUTH_HOST=auth.museo.example.org
PUBLIC_APP_URL=https://museo.example.org
PUBLIC_AUTH_URL=https://auth.museo.example.org
PROXY_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

MUSEO_DB_NAME=museo
MUSEO_DB_ADMIN_USER=museo_bootstrap
MUSEO_DB_ADMIN_PASSWORD=CHANGE_ME_RANDOM_MUSEO_BOOTSTRAP_PASSWORD
MUSEO_DB_MIGRATOR_USER=museo_migrator
MUSEO_DB_MIGRATOR_PASSWORD=CHANGE_ME_RANDOM_MUSEO_MIGRATOR_PASSWORD
MUSEO_DB_RUNTIME_USER=museo_app
MUSEO_DB_RUNTIME_PASSWORD=CHANGE_ME_RANDOM_MUSEO_RUNTIME_PASSWORD
# One-time only when upgrading a pre-Phase-5 PostgreSQL volume:
# MUSEO_DB_LEGACY_ADMIN_USER=museo_app
# MUSEO_DB_LEGACY_OWNER=museo_app

KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_ADMIN_USER=keycloak_bootstrap
KEYCLOAK_DB_ADMIN_PASSWORD=CHANGE_ME_RANDOM_KEYCLOAK_BOOTSTRAP_DB_PASSWORD
KEYCLOAK_DB_USER=keycloak_app
KEYCLOAK_DB_PASSWORD=CHANGE_ME_RANDOM_KEYCLOAK_DB_PASSWORD
# One-time only when upgrading a pre-Phase-5 PostgreSQL volume:
# KEYCLOAK_DB_LEGACY_ADMIN_USER=keycloak_app
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=CHANGE_ME_BOOTSTRAP_ADMIN
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_RANDOM_BOOTSTRAP_PASSWORD

KEYCLOAK_REALM=museo
KEYCLOAK_FRONTEND_CLIENT_ID=museo-frontend
KEYCLOAK_BACKEND_CLIENT_ID=museo-backend
KEYCLOAK_ADMIN_CLIENT_ID=museo-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME_RANDOM_CLIENT_SECRET

# Operational defaults. Override only after documenting the change.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
RECONCILE_MIN_AGE_HOURS=24
BACKUP_MAX_AGE_HOURS=30
DISK_USAGE_WARN_PERCENT=80
TLS_WARN_DAYS=30

# Optional off-host replication. Choose exactly one transport in production.
# BACKUP_EXTERNAL_MODE=mounted
# BACKUP_EXTERNAL_PATH=/mnt/independent-nas/museo-backups
# BACKUP_EXTERNAL_MODE=rsync-ssh
# BACKUP_EXTERNAL_SSH_TARGET=backup@museo-backup.example.org:/srv/backups/museo/
# BACKUP_EXTERNAL_SSH_KEY=/run/secrets/museo_backup_ssh_key
# BACKUP_EXTERNAL_KNOWN_HOSTS=/etc/ssh/ssh_known_hosts
